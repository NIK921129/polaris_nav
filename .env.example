# ============================================================
# POLARIS NAV - Environment Variables
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
CORS_ORIGIN=*
LOG_LEVEL=info

# --- Database (MongoDB Atlas free tier) ---
# Leave blank to run in DB-less demo mode
MONGODB_URI=
MONGODB_DB_NAME=polaris_nav

# --- Auth ---
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# --- Optional FREE API keys (leave blank -> mock data) ---
OPENWEATHER_API_KEY=
NSIDC_API_KEY=
NASA_API_KEY=DEMO_KEY
MAPBOX_API_KEY=
GEMINI_API_KEY=